# Copie para .env para rodar o sync na sua máquina (npm run sync). No GitHub, use Secrets.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-NUNCA-COMMITAR
ATUALIZAR_PRODUZIDO=true

# ---- Origem da base: preencha UMA das três e deixe as outras em branco ----

# 1) SharePoint: caminho direto do arquivo .xlsx ou .csv (Detalhes do arquivo → Caminho)
SHAREPOINT_URL=
# Opcional: nome da aba do .xlsx (em branco usa a primeira)
SHAREPOINT_ABA=
# App registrado no Microsoft Entra ID com a permissão Sites.Selected liberada no site
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# 2) Google Sheets: link da planilha (já na aba da base)
GOOGLE_SHEETS_URL=
# Opcional: nome da aba (em branco usa a aba do gid no link)
GOOGLE_SHEETS_ABA=
# Conteúdo do .json da conta de serviço, numa linha só. Em branco = planilha compartilhada por link.
GOOGLE_SERVICE_ACCOUNT_JSON=

# 3) API da base
BASE_API_URL=
BASE_API_TOKEN=
# Opcional: nome do cabeçalho do token (padrão Authorization: Bearer <token>)
BASE_API_HEADER=Authorization
